
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>
    @{
            ViewData["Title"] = "Student Details";
     }

     <h2>@ViewData["Message"]</h2>
     <p><b>Name: </b> @ViewData["name"]</p>
     <p><b>Age: </b> @ViewData["age"]</p>

     

    @if((int)ViewData["age"] > 18)
        {
            <p style="color:green;"><b>Eligible</b></p>
        }
    else
        {
        <p style="color:red;"><b>Not Eligible</b></p>
        }

</body>
</html>
